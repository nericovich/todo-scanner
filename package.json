{
  "name": "todo-scanner",
  "displayName": "TODO Scanner",
  "description": "Поиск TODO и FIXME задач в проекте",
  "version": "0.0.1",
  "publisher": "my-name",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:todoTreeView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todo-container",
          "title": "TODO Scanner",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "todo-container": [
        {
          "id": "todoTreeView",
          "name": "Найденные задачи"
        }
      ]
    },
    "commands": [
      {
        "command": "todoScanner.refresh",
        "title": "Обновить список",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "todoScanner.refresh",
          "when": "view == todoTreeView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}